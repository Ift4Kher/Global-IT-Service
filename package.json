{
  "name": "global-it",
  "version": "1.0.0",
  "description": "Production-ready Full-Stack Global IT Services recreation website",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node src/server.js",
    "build:css": "tailwindcss -i ./src/styles/input.css -o ./public/assets/css/styles.css --minify",
    "watch:css": "tailwindcss -i ./src/styles/input.css -o ./public/assets/css/styles.css --watch",
    "build": "npm run build:css",
    "test": "node --test tests/api.test.js"
  },
  "keywords": [
    "global-it",
    "it-services",
    "express",
    "mysql",
    "tailwind"
  ],
  "author": "Global IT",
  "license": "ISC",
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "mysql2": "^3.12.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "autoprefixer": "^10.4.20",
    "postcss": "^8.5.1",
    "sharp": "^0.33.5",
    "tailwindcss": "^3.4.17"
  }
}
